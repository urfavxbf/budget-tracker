<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.FilledBox</item>
    </style>
    <style name="ThemeOverlay.BudgetTracker.Blue">
        <item name="colorPrimary">#B6C5FF</item>
        <item name="colorOnPrimary">#1D347D</item>
        <item name="colorSecondaryContainer">#343F66</item>
        <item name="colorOnSecondaryContainer">#DAE1FF</item>
        <item name="android:colorAccent">#B6C5FF</item>
    </style>
    <style name="ThemeOverlay.BudgetTracker.Teal">
        <item name="colorPrimary">#84DBCE</item>
        <item name="colorOnPrimary">#003F37</item>
        <item name="colorSecondaryContainer">#214D47</item>
        <item name="colorOnSecondaryContainer">#C3EFE7</item>
        <item name="android:colorAccent">#84DBCE</item>
    </style>
    <style name="ThemeOverlay.BudgetTracker.Violet">
        <item name="colorPrimary">#D3B8FF</item>
        <item name="colorOnPrimary">#402567</item>
        <item name="colorSecondaryContainer">#4C3A65</item>
        <item name="colorOnSecondaryContainer">#F0DFFF</item>
        <item name="android:colorAccent">#D3B8FF</item>
    </style>
    <style name="ThemeOverlay.BudgetTracker.Rose">
        <item name="colorPrimary">#FFAFCC</item>
        <item name="colorOnPrimary">#64183C</item>
        <item name="colorSecondaryContainer">#633349</item>
        <item name="colorOnSecondaryContainer">#FFD9E6</item>
        <item name="android:colorAccent">#FFAFCC</item>
    </style>
</resources>
